{
  "name": "lunar-landing-site-navigator",
  "private": true,
  "type": "module",
  "description": "Demo web estatica. Three.js se compila con esbuild en web/build/; Node tambien corre las pruebas.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/compilar.mjs",
    "datos": "python3 scripts/generar_escenario_demo.py",
    "empaquetar": "node scripts/compilar.mjs && python3 scripts/empaquetar_demo.py",
    "servir": "python3 -m http.server 8000"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
